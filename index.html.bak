<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Makky Mgbemena — Data & Business Analyst and Cloud Automation Engineer in Toronto.">
  <title>Makky Mgbemena | Data & Business Analyst</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#home" aria-label="Makky Mgbemena home">
      <span class="brand-mark">MM</span>
      <span class="brand-name">Makky Mgbemena</span>
    </a>

    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span>
    </button>

    <nav class="nav" aria-label="Primary navigation">
      <a class="active" href="#home">Home</a>
      <a href="#expertise">Expertise</a>
      <a href="#work">Selected work</a>
      <a href="#resume">Résumé</a>
      <a class="nav-contact" href="mailto:mgbemenamakuochukwu@gmail.com">Contact</a>
    </nav>
  </header>

  <main id="home" class="hero">
    <section class="hero-copy">
      <p class="eyebrow">Toronto, Canada · Open to work</p>
      <h1>I turn complex data into <em>clear business action.</em></h1>
      <p class="intro">
        I’m <strong>Makky Mgbemena</strong>, a Data &amp; Business Analyst and Cloud
        Automation Engineer building reliable reporting, financial automation,
        and decision-ready data systems.
      </p>

      <div class="actions">
        <a class="button primary" href="#work">View selected work <span>↗</span></a>
        <a class="button secondary" href="mailto:mgbemenamakuochukwu@gmail.com">Email me</a>
      </div>

      <div class="proof" aria-label="Core capabilities">
        <div><strong>Analytics</strong><span>SQL · Excel · Power BI</span></div>
        <div><strong>Cloud data</strong><span>BigQuery · Snowflake</span></div>
        <div><strong>Automation</strong><span>Python · FastAPI · APIs</span></div>
      </div>
    </section>

    <aside class="portrait-wrap" aria-label="Portrait of Makky Mgbemena">
      <div class="portrait-frame">
        <img src="assets/profile-cutout-clean-v4.png" alt="Makky Mgbemena smiling">
      </div>
      <div class="availability">
        <span class="status-dot"></span>
        <p><strong>Available for opportunities</strong><br>Analyst · Automation · Data systems</p>
      </div>
      <span class="decor decor-one" aria-hidden="true"></span>
      <span class="decor decor-two" aria-hidden="true"></span>
    </aside>
  </main>

  <section id="expertise" class="preview-strip" aria-label="Portfolio preview">
    <p>Field-validated work</p>
    <span>Revenue intelligence</span>
    <span>Financial reconciliation</span>
    <span>AP automation</span>
    <span>Executive reporting</span>
  </section>

  <section id="work" class="work-section">
    <div class="section-heading">
      <div>
        <p class="section-label">Selected work</p>
        <h2>Systems built for real decisions.</h2>
      </div>
      <p>Cloud pipelines, automation, and reporting systems designed around traceable business outcomes.</p>
    </div>

    <article class="project-card">
      <div class="project-copy">
        <p class="project-number">01 / Cloud enterprise</p>
        <h3>BigQuery → Excel Revenue Intelligence</h3>
        <p>A cloud-integrated pipeline that models GA4 transaction data in BigQuery, connects governed reporting data to Excel, and produces decision-ready revenue analysis.</p>
        <ul>
          <li>BigQuery SQL modeling</li>
          <li>Excel and Power Query reporting</li>
          <li>ODBC-connected analytics workflow</li>
        </ul>
      </div>
      <div class="project-gallery cloud-gallery">
        <figure class="shot shot-main">
          <img src="assets/excel-dashboard.png" alt="Excel executive revenue dashboard">
          <figcaption>Executive revenue dashboard</figcaption>
        </figure>
        <figure class="shot shot-secondary">
          <img src="assets/bigquery-cloud-work.png" alt="BigQuery revenue intelligence query">
          <figcaption>Cloud SQL transformation layer</figcaption>
        </figure>
      </div>
    </article>

    <article class="project-card reverse">
      <div class="project-copy">
        <p class="project-number">02 / Financial automation</p>
        <h3>AP Invoice Processor</h3>
        <p>An end-to-end accounts-payable workflow that extracts invoice data, validates it, routes human approvals, records decisions, and synchronizes approved bills with QuickBooks.</p>
        <ul>
          <li>FastAPI and Streamlit application</li>
          <li>OCR and structured validation</li>
          <li>Approval and QuickBooks workflow</li>
        </ul>
      </div>
      <div class="project-gallery invoice-gallery">
        <figure class="shot shot-main">
          <img src="assets/invoice-processor.png" alt="AP Invoice Processor dashboard">
          <figcaption>Invoice operations dashboard</figcaption>
        </figure>
        <figure class="shot shot-secondary portrait-shot">
          <img src="assets/invoice-approval.png" alt="Invoice approval review">
          <figcaption>Human approval checkpoint</figcaption>
        </figure>
      </div>
    </article>

    <article class="confidential-card">
      <div class="lock" aria-hidden="true">🔒</div>
      <div>
        <p class="project-number">Confidential client engagements</p>
        <h3>Business audits protected by professional discretion.</h3>
        <p>Procurement analysis, financial variance detection, and revenue reconciliation completed in real business environments. Client identities and underlying records are intentionally withheld.</p>
      </div>
      <div class="confidential-tags">
        <span>Data profiling</span><span>Variance detection</span><span>Vendor analysis</span><span>Audit-ready reporting</span>
      </div>
    </article>
  </section>

  <footer>
    <span>Makky Mgbemena</span>
    <a href="https://github.com/MakkyMgbemena" target="_blank" rel="noreferrer">GitHub ↗</a>
    <a href="mailto:mgbemenamakuochukwu@gmail.com">mgbemenamakuochukwu@gmail.com</a>
  </footer>

  <script src="main.js"></script>
</body>
</html>
